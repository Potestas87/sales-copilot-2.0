# Copy this file to .env and fill in your values
# Never commit .env to git

# RunPod server address (set once your GPU pod is running)
SERVER_HOST=your-runpod-host
SERVER_PORT=8000

# Audio device settings — use NAMES (stable) instead of indexes (shift on reconnect)
# Run 'python3 client/audio_capture.py' to see available device names
MIC_DEVICE_NAME=SoloCast
CALL_DEVICE_NAME=BlackHole

# Fallback: raw index numbers (only used if names above are not set)
# MIC_DEVICE_INDEX=4
# CALL_AUDIO_DEVICE_INDEX=9

# Whisper model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3

# LLM settings
LLM_MODEL_PATH=models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
LLM_MAX_TOKENS=300