# ══════════════════════════════════════════════════════════════════════════════
# Dockerfile.base — Heavy ML dependencies, compiled once and reused
# ══════════════════════════════════════════════════════════════════════════════
#
# This image contains everything that's slow to build and rarely changes:
#   - CUDA 12.8 devel toolkit (nvcc, headers, cuBLAS)
#   - llama-cpp-python pre-compiled with GGML_CUDA=ON
#   - faster-whisper and its CTranslate2 backend
#   - FastAPI, uvicorn, and all server Python dependencies
#
# BUILD PROCESS
# ─────────────
# llama-cpp-python requires a real NVIDIA GPU driver (libcuda.so.1) to compile
# with CUDA support. Since GitHub Actions runners have no GPU, we split the
# build into two steps:
#
#   1. WHEEL (on GPU pod):  scripts/build-base-image.sh compiles the wheel
#      and uploads it to a GitHub Release as a binary asset.
#
#   2. IMAGE (on GitHub Actions):  .github/workflows/docker-base.yml downloads
#      the wheel from the release and builds this Dockerfile — no CUDA
#      compilation needed. Runs in under 10 minutes.
#
# Rebuild ONLY when you:
#   - Upgrade llama-cpp-python, faster-whisper, or CUDA versions
#   - Add/remove packages in requirements-server.txt
#
# The app Dockerfile (docker/Dockerfile) inherits FROM this image and only
# copies application code — making app builds take < 60 seconds.
#
# CUDA ARCHITECTURE SUPPORT
# ─────────────────────────
# The wheel is compiled for: sm_75 (Turing), sm_80/86 (Ampere), sm_89 (Ada)
# Newer GPUs (e.g. RTX 5090 / Blackwell sm_120a) JIT-compile from included
# PTX at first launch via NVIDIA's forward-compatibility mechanism.
#
# ══════════════════════════════════════════════════════════════════════════════

FROM nvidia/cuda:12.8.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# ── NVIDIA Container Runtime ─────────────────────────────────────────────────
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --upgrade pip setuptools wheel
RUN python3.11 -m ensurepip --upgrade || true
RUN python3.11 -m pip install --upgrade pip setuptools wheel || true

# ── llama-cpp-python (pre-compiled with CUDA) ────────────────────────────────
# The wheel is downloaded from a GitHub Release by the CI workflow and placed
# in the wheels/ directory before this Dockerfile runs.
COPY wheels/llama_cpp_python*.whl /tmp/
RUN set -eux; \
    WHEEL="$(ls /tmp/llama_cpp_python*.whl | head -n 1)"; \
    echo "Installing wheel: ${WHEEL}"; \
    python3 --version || true; \
    pip3 --version || true; \
    python3.11 --version || true; \
    python3.11 -m pip --version || true; \
    if echo "${WHEEL}" | grep -q "cp311"; then \
      python3.11 -m pip install "${WHEEL}"; \
    else \
      pip3 install "${WHEEL}"; \
    fi; \
    rm -f /tmp/llama_cpp_python*.whl

# ── Server Python dependencies ───────────────────────────────────────────────
COPY requirements-server.txt /tmp/requirements-server.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements-server.txt

# ── Base image metadata ──────────────────────────────────────────────────────
LABEL maintainer="potestas87"
LABEL description="Sales Copilot base image — CUDA 12.8 + llama-cpp-python (GPU) + faster-whisper"
